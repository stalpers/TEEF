{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TEEF conformance case",
  "description": "Describes one conformance case: its input and the result a conformant recipient must produce.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "input", "expected"],
  "properties": {
    "description": { "type": "string", "pattern": "\\S" },
    "input": { "enum": ["package", "package.zip"] },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousPackages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*manifest\\.json$" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "maxArchiveBytes": { "type": "integer", "minimum": 1 },
            "maxEntries": { "type": "integer", "minimum": 1 },
            "maxExpandedBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "intakeDate": { "type": "string", "format": "date" },
        "knownQuestionnaires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "version": { "type": "string", "pattern": "\\S" }
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "errors", "warnings"],
      "properties": {
        "result": { "enum": ["valid", "invalid", "any"] },
        "errors": { "$ref": "#/$defs/ruleIds" },
        "warnings": { "$ref": "#/$defs/ruleIds" }
      },
      "if": { "properties": { "result": { "const": "invalid" } } },
      "then": { "properties": { "errors": { "minItems": 1 } } },
      "else": { "properties": { "errors": { "maxItems": 0 } } }
    }
  },
  "$defs": {
    "ruleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^TEEF-[A-Z]+-[0-9]{2}$" }
    }
  }
}
